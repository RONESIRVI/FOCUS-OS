<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/focus_surface"
    android:padding="12dp">

    <!-- Session & Progress Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <!-- Subject & Session Name -->
            <TextView
                android:id="@+id/notif_exp_subject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📚 UPSC GS • General Studies"
                android:textColor="@color/focus_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
                
            <!-- Lock Mode Badge -->
            <TextView
                android:id="@+id/notif_exp_mode_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_notif_pill"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="STRICT LOCK"
                android:textColor="@color/focus_warning"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Center Countdown Timer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/notif_exp_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="45:00"
                android:textColor="@color/focus_text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />
                
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="10dp">
                <TextView
                    android:id="@+id/notif_exp_status_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REMAINING FOCUS"
                    android:textColor="@color/focus_text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/notif_exp_distraction_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡️ 0 Blocked"
                    android:textColor="@color/focus_accent"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/notif_exp_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="60" />

        <!-- Progress Status & Sound Metadata -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/notif_exp_progress_percent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="60% Completed"
                android:textColor="@color/focus_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_exp_sound_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎵 Binaural Alpha 40Hz"
                android:textColor="@color/focus_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Quick Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical">

        <!-- Pause / Resume Button -->
        <LinearLayout
            android:id="@+id/notif_btn_pause_resume"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_notif_btn"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageView
                android:id="@+id/notif_btn_pause_resume_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_notif_pause"
                android:contentDescription="Pause/Resume" />

            <TextView
                android:id="@+id/notif_btn_pause_resume_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="PAUSE"
                android:textColor="@color/focus_text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Add +5 Minutes Button -->
        <LinearLayout
            android:id="@+id/notif_btn_add_time"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_notif_btn"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageView
                android:id="@+id/notif_btn_add_time_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_notif_plus"
                android:contentDescription="Add Time" />

            <TextView
                android:id="@+id/notif_btn_add_time_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="+5 MINS"
                android:textColor="@color/focus_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Return to Focus App Button -->
        <LinearLayout
            android:id="@+id/notif_btn_open_app"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/bg_notif_btn"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_notif_app"
                android:contentDescription="Open App" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="APP"
                android:textColor="@color/focus_text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
