<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/focus_surface"
    android:padding="14dp">

    <!-- Top App Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/notif_exp_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_notif_shield"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/notif_exp_app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="FOCUS OS"
            android:textColor="@color/focus_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <!-- Distraction Shield Badge -->
        <TextView
            android:id="@+id/notif_exp_distraction_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_notif_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:layout_marginEnd="6dp"
            android:text="🛡️ 0 Blocked"
            android:textColor="@color/focus_accent"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Lock Mode Badge -->
        <TextView
            android:id="@+id/notif_exp_mode_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_notif_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="STRICT LOCK"
            android:textColor="@color/focus_warning"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Session & Progress Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp">

        <!-- Subject & Session Name -->
        <TextView
            android:id="@+id/notif_exp_subject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📚 UPSC GS • General Studies"
            android:textColor="@color/focus_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Center Countdown Timer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/notif_exp_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="45:00"
                android:textColor="@color/focus_text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_exp_status_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="REMAINING FOCUS"
                android:textColor="@color/focus_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/notif_exp_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="60"
            android:progressDrawable="@drawable/bg_notif_progress" />

        <!-- Progress Status & Sound Metadata -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/notif_exp_progress_percent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="60% Completed"
                android:textColor="@color/focus_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_exp_sound_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎵 Binaural Alpha 40Hz"
                android:textColor="@color/focus_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Quick Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical">

        <!-- Pause / Resume Button -->
        <LinearLayout
            android:id="@+id/notif_btn_pause_resume"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_notif_btn"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageView
                android:id="@+id/notif_btn_pause_resume_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_notif_pause"
                android:contentDescription="Pause/Resume" />

            <TextView
                android:id="@+id/notif_btn_pause_resume_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="PAUSE"
                android:textColor="@color/focus_text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Add +5 Minutes Button -->
        <LinearLayout
            android:id="@+id/notif_btn_add_time"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_notif_btn"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_notif_plus"
                android:contentDescription="Add Time" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="+5 MINS"
                android:textColor="@color/focus_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Return to Focus App Button -->
        <LinearLayout
            android:id="@+id/notif_btn_open_app"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_notif_btn"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_notif_app"
                android:contentDescription="Open App" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="APP"
                android:textColor="@color/focus_text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
